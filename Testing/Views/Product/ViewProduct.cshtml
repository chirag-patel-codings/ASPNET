@model Product;

<h3>@Model.Name Information:</h3>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category ID</th>
        <th>On Sale</th>
        <th>Stock Level</th>
    </tr>
    <tr>
        <td>@Model.ProductID</td>
        <td>@Model.Name</td>
        <td>@Model.Price</td>
        <td>@Model.CategoryID</td>
        <td>@Model.OnSale</td>
        <td>@Model.StockLevel</td>
    </tr>

</table>

<div>
    <a href="/Product/UpdateProduct/@Model.ProductID" class="btn btn-link text-primary border-primary" style="display: inline-block; vertical-align: center;" >Update Product</a>
    @using (Html.BeginForm ("DeleteProduct", "Product", FormMethod.Post, new { id = "deleteProductForm" + @Model.ProductID, style="display: inline-block; vertical-align: center;"  }))
    {
         @Html.Hidden("productId", @Model.ProductID)
         <input type="submit" id="delete-@Model.ProductID" value="DELETE PRODUCT" class="btn btn-link text-danger border-danger" onclick="return confirm('Are you sure you want to delete the product with Product ID: \n' + @Model.ProductID + '?');" />
    }
</div>