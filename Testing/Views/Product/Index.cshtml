@model IEnumerable<Product>;


<h2>Products</h2>

<p>
    <a href="/Product/CreateProduct" class="btn btn-success">Create Product</a>
</p>

<table class="table">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category ID</th>
        <th>On Sale</th>
        <th>Stock Level</th>
        <th>&nbsp;</th>
        <th>&nbsp;</th>
    </tr>
    @foreach (var product in @Model)
    {
        <tr>
            <td><a href="/Product/ViewProduct/@product.ProductID">@product.ProductID</a> </td>
            <td>@product.Name</td>
            <td>@product.Price</td>
            <td>@product.CategoryID</td>
            <td>@product.OnSale</td>
            <td>@product.StockLevel</td>
            <td class="align-middle"><a href="/Product/UpdateProduct/@product.ProductID">UPDATE</a></td>
            <td class="align-middle">
                @using (Html.BeginForm ("DeleteProduct", "Product", FormMethod.Post, new { id = "deleteProductForm" }))
                {
                    @Html.Hidden("productId", product.ProductID)
                    <input type="submit" id="delete" value="DELETE" class="btn btn-link text-danger" onclick="return confirm('Are you sure you want to delete this product?');" />
                }
            </td>
        </tr>
    }
</table>